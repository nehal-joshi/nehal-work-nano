---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';

export async function getStaticPaths({ paginate }) {
  const posts = (await getCollection('blog')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );
  return paginate(posts, { pageSize: 10 });
}

const { page } = Astro.props;
const notesUrl = new URL('/notes', Astro.site).toString();
const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Notes by Nehal Joshi',
  description: 'Notes on education, AI, product design, and first-principles learning.',
  url: notesUrl,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: page.data.map((post, index) => ({
      '@type': 'ListItem',
      position: (page.currentPage - 1) * page.size + index + 1,
      url: new URL(`/notes/${post.id.replace(/\.(md|mdx)$/i, '')}`, Astro.site).toString(),
      name: post.data.title,
    })),
  },
};
---

<BaseLayout
  title="Notes | Nehal Joshi"
  description="Thoughts on education, design, and learning systems."
  structuredData={collectionSchema}
>
  <section class="space-y-8">
    <div class="space-y-2">
      <h1 class="text-2xl md:text-[1.75rem] font-semibold leading-[var(--leading-heading)]">Notes</h1>
      <p class="text-sm text-muted-foreground">
        Thoughts, ideas, and reflections on education, technology, design, and the intersection of all three.
      </p>
    </div>

    {page.data.length === 0 ? (
      <p class="text-muted-foreground">No notes found.</p>
    ) : (
      <ul class="flex flex-col gap-4">
        {page.data.map((post, index) => (
          <li>
            <ArticleCard
              article={{
                slug: post.id.replace(/\.(md|mdx)$/i, ''),
                title: post.data.title,
                excerpt: post.data.description,
                date: post.data.pubDate,
              }}
              index={(page.currentPage - 1) * page.size + index}
            />
          </li>
        ))}
      </ul>
    )}

    {page.lastPage > 1 && (
      <nav class="flex items-center justify-between pt-4 text-sm text-muted-foreground">
        {page.url.prev ? (
          <a href={page.url.prev} class="hover:text-foreground transition-colors">
            &larr; Newer
          </a>
        ) : (
          <span />
        )}
        <span>Page {page.currentPage} of {page.lastPage}</span>
        {page.url.next ? (
          <a href={page.url.next} class="hover:text-foreground transition-colors">
            Older &rarr;
          </a>
        ) : (
          <span />
        )}
      </nav>
    )}
  </section>
</BaseLayout>
