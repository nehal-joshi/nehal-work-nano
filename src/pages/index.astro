---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import ArticleCard from '../components/ArticleCard.astro';
import PhotoBento from '../components/photoBento.astro';
import projects from '../content/projects/projects.json';

const latestArticles = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const homepageUrl = new URL('/', Astro.site).toString();
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Nehal Joshi',
  url: homepageUrl,
  jobTitle: 'Education Product Leader and Founder',
  description:
    'Education product leader and designer building AI-native learning experiences. Founder of Lernok.',
  image: new URL('/nehal-joshi-pfp.jpg', Astro.site).toString(),
  worksFor: {
    '@type': 'Organization',
    name: 'Lernok',
    url: 'https://lernok.com/',
  },
  sameAs: [
    'https://www.linkedin.com/in/nehaljoshi',
    'https://x.com/nehalmax',
    'https://peerlist.io/nehal',
    'https://www.flickr.com/photos/nehaljoshi/',
  ],
};

type ProjectCard = {
  title: string;
  description: string;
  url: string;
  thumbnailImage?: string;
};

const builtProjects = projects as ProjectCard[];

---

<BaseLayout
  title="Nehal Joshi | Education Product Leader, Designer, and Founder of Lernok"
  description="Nehal Joshi is an education product leader, designer, and founder of Lernok, building AI-native learning products that teach coding, design, and first-principles thinking."
  structuredData={personSchema}
>
  <div class="space-y-14 md:space-y-16">
    <section class="space-y-5">
      <div class="flex flex-row items-center gap-4">
        <div class="w-12 h-12 rounded-full overflow-hidden shrink-0">
          <a href="/nehal-joshi-pfp.jpg" target="_blank" rel="noopener noreferrer">
            <img src="/nehal-small-pfp.jpg" alt="Nehal Joshi" class="w-full h-full object-cover" />
          </a>
        </div>
        <div>
          <h1 class="text-2xl md:text-[1.75rem] font-semibold leading-[var(--leading-heading)] text-foreground">Nehal Joshi</h1>
          <p class="text-sm text-muted-foreground">Educator · Designer · Builder</p>
        </div>
      </div>
      <p class="text-lg text-foreground leading-[var(--leading-body)]">
        I build learning products that teach people how to think. Grounded in first principles and driven by curiosity.
      </p>
    </section>

    <section class="space-y-4 text-foreground/90">
      <p>
        For 15 years I've been designing how people learn — from building K-12 ICT curricula used in 200+ schools by over 200,000 students worldwide, to running digital literacy programs for senior citizens.
      </p>
      <p>
        Today I'm building <a href="https://lernok.com/" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 decoration-1 hover:text-primary">Lernok</a>, an edtech platform that teaches kids to become builders using first-principles thinking, preparing them for an AI-native world.
      </p>
      <p>
        Outside of work, I play chess, read obsessively, do street <a href="https://flickr.com/photos/nehaljoshi/" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 decoration-1 hover:text-primary">photography</a> with my Fujifilm cameras, and explore ideas across disciplines.
      </p>
    </section>

    <section class="space-y-3">
      <h2 class="text-base font-semibold text-foreground">Guiding Principle</h2>
      <p class="text-foreground/90">
        Good education should start with first principles, where fundamentals come before tools. It should encourage curiosity and experimentation, connect ideas to real-world problems, and stay accessible to anyone willing to learn.
      </p>
    </section>

    <section class="space-y-5">
      <div class="flex flex-wrap gap-y-1 items-center justify-between">
        <h2 class="text-base font-semibold text-foreground">Writing</h2>
        <a href="/notes" class="text-sm text-muted-foreground underline underline-offset-4 decoration-1 hover:text-foreground transition-colors">See all notes</a>
      </div>
      {latestArticles.length === 0 ? (
        <p class="text-muted-foreground">No notes available yet.</p>
      ) : (
        <ul class="flex flex-col gap-4">
          {latestArticles.map((article, index) => (
            <li>
              <ArticleCard
                article={{
                  slug: article.id.replace(/\.(md|mdx)$/i, ''),
                  title: article.data.title,
                  excerpt: article.data.description,
                  date: article.data.pubDate,
                }}
                index={index}
              />
            </li>
          ))}
        </ul>
      )}
    </section>

    <section class="space-y-5">
      <div class="space-y-1">
        <h2 class="text-base font-semibold text-foreground">Things I've Built</h2>
        <p class="text-sm text-muted-foreground">
          A few side projects built using AI-first, vibe coding workflows.
        </p>
      </div>
      <ul class="flex flex-col gap-4">
        {builtProjects.map((project, index) => (
          <li>
            <a
              href={project.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center gap-4 animate-fade-in"
              style={`animation-delay: ${index * 60}ms;`}
            >
              <span class="w-8 h-8 rounded-md overflow-hidden bg-muted shrink-0">
                {project.thumbnailImage ? (
                  <img src={project.thumbnailImage} alt="" class="w-full h-full object-cover" />
                ) : null}
              </span>
              <span class="flex-1 min-w-0">
                <span class="block font-medium text-foreground group-hover:underline underline-offset-4 decoration-1">{project.title}</span>
                <span class="block text-sm text-muted-foreground line-clamp-1">{project.description}</span>
              </span>
              <span class="shrink-0 text-xs text-muted-foreground" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <PhotoBento />
    </section>

    {/* <section class="space-y-5">
      <h2 class="text-base font-semibold text-foreground">Experience</h2>
      <ol class="flex flex-col gap-4">
        {experience.map((entry) => (
          <li class="flex items-baseline justify-between gap-4">
            <span class="min-w-0">
              <span class="block font-medium text-foreground">{entry.role}</span>
              <span class="block text-sm text-muted-foreground">{entry.organisation}</span>
            </span>
            <time class="shrink-0 text-xs text-muted-foreground tabular-nums">{entry.range}</time>
          </li>
        ))}
      </ol>
    </section> */}

    <section class="space-y-3">
      <h2 class="text-base font-semibold text-foreground">Let's Connect</h2>
      <p>
        If you want to say hi, talk learning, or trade photography notes, reach out on any of these.
      </p>
      <ul class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm">
        <li>
          <button
            type="button"
            class="underline underline-offset-4 decoration-1 hover:text-foreground transition-colors cursor-pointer bg-transparent border-0 p-0 font-inherit text-inherit"
            aria-label="Copy nehal@lernok.com to clipboard"
            data-copy-email
          >
            nehal@lernok.com
          </button>
        </li>
        <li aria-hidden="true" class="text-muted-foreground">/</li>
        <li><a href="https://peerlist.io/nehal" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 decoration-1 hover:text-foreground transition-colors">peerlist</a></li>
        <li aria-hidden="true" class="text-muted-foreground">/</li>
        <li><a href="https://linkedin.com/in/nehaljoshi" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 decoration-1 hover:text-foreground transition-colors">linkedin</a></li>
        <li aria-hidden="true" class="text-muted-foreground">/</li>
        <li><a href="https://x.com/nehalmax" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 decoration-1 hover:text-foreground transition-colors">x</a></li>
        <li aria-hidden="true" class="text-muted-foreground">/</li>
        <li><a href="https://www.flickr.com/photos/nehaljoshi/" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 decoration-1 hover:text-foreground transition-colors">flickr</a></li>
      </ul>
    </section>
  </div>
  <p
    id="copy-email-toast"
    class="pointer-events-none fixed bottom-8 left-1/2 z-50 -translate-x-1/2 rounded-md bg-muted px-2.5 py-1 text-xs text-muted-foreground opacity-0 transition-opacity duration-200 ease-out"
    role="status"
    aria-live="polite"
    aria-hidden="true"
  ></p>
  <script is:inline>
    (function () {
      const btn = document.querySelector('[data-copy-email]');
      const toast = document.getElementById('copy-email-toast');
      if (!btn || !toast) return;
      let hideTimer = 0;
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText('nehal@lernok.com');
          window.clearTimeout(hideTimer);
          toast.textContent = 'Email Copied';
          toast.classList.add('opacity-100');
          toast.setAttribute('aria-hidden', 'false');
          hideTimer = window.setTimeout(() => {
            toast.classList.remove('opacity-100');
            toast.setAttribute('aria-hidden', 'true');
            toast.textContent = '';
          }, 1600);
        } catch {
          /* Clipboard API unavailable or permission denied */
        }
      });
    })();
  </script>
</BaseLayout>
