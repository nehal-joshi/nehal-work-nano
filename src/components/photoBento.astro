---
import photos from '../content/photos/photos.json';

type PhotoItem = {
  title: string;
  imageUrl: string;
  alt?: string;
  linkUrl?: string;
  orientation: 'portrait' | 'landscape';
};

const allPhotos = photos as PhotoItem[];
const portraitPhotos = allPhotos.filter((photo) => photo.orientation === 'portrait').slice(0, 2);
const landscapePhotos = allPhotos.filter((photo) => photo.orientation === 'landscape').slice(0, 3);
const photoItems = [
  portraitPhotos[0],
  landscapePhotos[0],
  landscapePhotos[1],
  portraitPhotos[1],
  landscapePhotos[2],
].filter(Boolean) as PhotoItem[];
---

<div class="space-y-5">
  <div class="space-y-1">
    <div class="flex flex-wrap gap-y-1 items-center justify-between">
      <h2 class="text-base font-semibold text-foreground">Photography</h2>
      <a href="https://www.flickr.com/photos/nehaljoshi/" target="_blank" rel="noopener noreferrer" class="text-sm text-muted-foreground underline underline-offset-4 decoration-1 hover:text-foreground transition-colors">See more</a>
    </div>
    <p class="text-sm text-muted-foreground">
      Street photography — noticing the quiet, unfiltered moments of everyday life.
    </p>
  </div>

  <div class="bento-grid bento-grid--fixed">
    {photoItems.map((photo, i) => (
      <a
        href={photo.linkUrl || photo.imageUrl}
        target="_blank"
        rel="noopener noreferrer"
        class:list={['bento-cell', `bento-slot-${i + 1}`]}
        title={photo.title}
      >
        {photo.imageUrl ? (
          <img
            src={photo.imageUrl}
            alt={photo.alt || photo.title}
            loading="lazy"
            decoding="async"
          />
        ) : (
          <div class="bento-cell-placeholder">
            <span>{photo.title}</span>
          </div>
        )}
      </a>
    ))}
  </div>
</div>
