---
const pathname = Astro.url.pathname;
const navItems = [
  { name: 'Notes', path: '/notes' },
];
---

<header class="w-full py-5 animate-fade-in">
  <div class="flex flex-row items-center justify-between">
    <a href="/" class="inline-block text-sm font-semibold hover:text-foreground transition-colors">Nehal Joshi</a>
    <nav>
      <ul class="flex items-center gap-4">
        {navItems.map((item) => (
          <li>
            <a href={item.path} class:list={['text-sm text-muted-foreground hover:text-foreground transition-colors underline underline-offset-4 decoration-1', pathname === item.path && 'text-foreground']}>
              {item.name.toLowerCase()}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
