---
interface ArticlePreview {
  slug: string;
  title: string;
  excerpt: string;
  date: string | Date;
}

interface Props {
  article: ArticlePreview;
  index?: number;
}

const { article, index = 0 } = Astro.props;
const date = new Date(article.date);
const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
});
---

<a
  href={`/notes/${article.slug}`}
  class="group flex items-baseline justify-between gap-6 animate-fade-in"
  style={`animation-delay: ${index * 60}ms;`}
>
  <span class="flex-1 min-w-0">
    <span class="block font-medium text-foreground group-hover:underline underline-offset-4 decoration-1">{article.title}</span>
    <span class="block text-sm text-muted-foreground line-clamp-1 mt-0.5">{article.excerpt}</span>
  </span>
  <time class="shrink-0 text-xs text-muted-foreground tabular-nums" datetime={date.toISOString()}>{formattedDate}</time>
</a>
